{
  "name": "tweenjs",
  "version": "0.1.0",
  "description": "Editeur d'animation vectorielle inspiré d'Adobe Animate, en JavaScript vanilla.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:vanilla": "vite build --config vite.vanilla.config.js",
    "build:pure-vanilla": "vite build --config vite.vanilla.config.js && copy dist\\tweenjs-bundle.iife.js ..\\Animate_JS_PureVanilla\\tweenjs-bundle.js",
    "build:pure-vanilla": "vite build --config vite.vanilla.config.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "konva": "^9.3.16"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.5.0",
    "vite": "^8.2.1"
  }
}
